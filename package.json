{
  "name": "software-engineering-portfolio",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/validate-content.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir .build && node scripts/prerender.mjs",
    "check": "tsc --noEmit && node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/profile-interaction.test.mjs",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "preview": "node scripts/serve.mjs",
    "build:release": "node scripts/validate-content.mjs --release && npm run build"
  },
  "engines": { "node": ">=22.23.4" },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "motion": "14.9.0",
    "three": "0.186.1",
    "postprocessing": "6.39.5",
    "lucide-react": "1.66.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/node": "24.13.3"
  }
}
